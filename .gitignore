# ==========================================
# Python Virtual Environments
# ==========================================
venv/
.venv/

# ==========================================
# Python Cache and Test Files
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ==========================================
# Environment Variables and API Keys
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# Large or Generated Datasets
# ==========================================
# Ignore all JSONL, JSON, Parquet, and temporary data files
data/**/*.jsonl
data/**/*.json
data/**/*.parquet
data/**/*.tmp
data/**/*.temp
data/**/*.xlsx
data/**/*.csv

# Ignore raw downloaded datasets
data/raw/

# Ignore generated processed datasets
data/processed/

# ==========================================
# Logs and Temporary Files
# ==========================================
*.log
*.tmp
*.temp
*.bak
*.swp
*~

# ==========================================
# IDE and Editor Files
# ==========================================
.vscode/
.idea/

# ==========================================
# Jupyter Notebook Checkpoints
# ==========================================
.ipynb_checkpoints/

# ==========================================
# Operating System Files
# ==========================================
.DS_Store
Thumbs.db